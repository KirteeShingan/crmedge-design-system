{
  "name": "crmedge-design-system",
  "version": "0.1.0",
  "private": true,
  "description": "CRMEdge B2B Design System — React components, design tokens, and Storybook.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "tokens:pull": "tsx scripts/export-figma-vars.ts",
    "tokens:build": "tsx scripts/build-tokens.ts",
    "tokens": "npm run tokens:pull && npm run tokens:build",
    "code-connect:publish": "figma connect publish",
    "deploy-storybook": "storybook-to-ghpages",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@figma/code-connect": "^1.4.4",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/addon-themes": "^8.6.18",
    "@storybook/react-vite": "^8.6.18",
    "@storybook/storybook-deployer": "^2.8.16",
    "@types/node": "^25.7.0",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "storybook": "^8.6.18",
    "style-dictionary": "^4.4.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^5.4.21"
  }
}
